DB_HOST=127.0.0.1
DB_NAME=novairlines_db
DB_USER=root
DB_PASS=tu_contraseña

DUFFEL_ACCESS_TOKEN=tu_duffel_token_aqui
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Google Places (New) - opcional. Requiere tarjeta y usa SKU Enterprise para rating.
GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui

# Geoapify - demo sin tarjeta (3,000 request/dia).
GEOAPIFY_API_KEY=tu_geoapify_api_key_aqui

# TomTom Search - gratis y sin tarjeta.
TOMTOM_API_KEY=tu_tomtom_api_key_aqui

# auto = Google si hay clave; si no, Geoapify + TomTom combinados.
# Valores: auto | google | geoapify | tomtom | ambos
LUGARES_PROVIDER=auto
LUGARES_CACHE_TTL_DIAS=30
LUGARES_MAX_CALLS_DIA=100

# Radio (metros) cuando la ciudad se resuelve con el geocodificador de TomTom.
LUGARES_RADIO_DINAMICO=25000
